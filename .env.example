# Copy to .env and edit. Everything has a sane default except PASSWORD.

# ---- web server -------------------------------------------------------------
PORT=4180
BIND_HOST=0.0.0.0
# Used to build cron ping URLs shown in the dashboard. Put the public address
# of the box here, e.g. https://monitor.example.com or http://<oci-public-ip>:4180
PUBLIC_URL=http://127.0.0.1:4180
PASSWORD=
SESSION_SECRET=
SESSION_HOURS=72
DB_PATH=./data/monitor.db
RETENTION_DAYS=7

# ---- sampling ---------------------------------------------------------------
METRICS_INTERVAL_SEC=30
CHECK_INTERVAL_SEC=60
CPU_WARN_PCT=90
MEM_WARN_PCT=90
DISK_WARN_PCT=90
LOAD_WARN_FACTOR=2
WARN_STREAK=3
SSL_WARN_DAYS=14
ALERT_COOLDOWN_MIN=30

# ---- extra servers ----------------------------------------------------------
# Auto-created at boot as name:key pairs (comma separated). Keys can also be
# generated in the dashboard under Agents.
AGENT_API_KEYS=

# ---- telegram ---------------------------------------------------------------
# Bot token from @BotFather. Chat ids: send the bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Ids allowed to use /restart. Leave empty to allow every chat id above.
TELEGRAM_OWNER_IDS=
DAILY_SUMMARY=true
SUMMARY_HOUR=8

# ---- AI root cause (optional) -----------------------------------------------
# none | openai | anthropic  (openai works with OpenRouter, Groq, Ollama, etc.)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ---- n8n defaults -----------------------------------------------------------
# Per-monitor values override these. Token: n8n -> Settings -> API.
N8N_URL=
N8N_API_KEY=

# ---- auto-restart -----------------------------------------------------------
# Master switch. Even with this on, a monitor only restarts if it has
# auto_restart ticked AND its command is in RESTART_ALLOW.
RESTART_ENABLED=true
# The ONLY commands this app is allowed to execute. Entries are separated by ";".
# A monitor can never run anything that is not listed here, and the app refuses
# anything whose first word is not systemctl / service / pm2 or whose second
# word is not restart / start / reload / reload-or-restart / try-restart.
# It runs them with execFile (no shell), so no pipes, ; or $( ) ever work.
# The service account still needs the sudoers line from README (auto-restart).
RESTART_ALLOW=systemctl restart n8n; systemctl restart workflow-monitor; pm2 restart n8n
# Extra guards applied to every entry: first word must be one of these binaries,
# second word one of these verbs. Only widen them if you really need to.
RESTART_ALLOW_BINS=systemctl,service,pm2
RESTART_ALLOW_VERBS=restart,start,reload,reload-or-restart,try-restart
# Seconds to wait after a restart before re-checking the monitor.
RESTART_WAIT_SEC=15
# Defaults used when a monitor leaves these fields blank.
RESTART_MAX_RETRIES=3
RESTART_COOLDOWN_MIN=10

# ---- backup monitor ---------------------------------------------------------
# Master switch for monitors of type "backup". Per-monitor settings
# (path/pattern, max_age_hours, min_size_mb, at_hour) live on the monitor itself.
BACKUP_ENABLED=true

# ---- security alerts --------------------------------------------------------
# Scans ssh logins and listening ports on the hub box only (agents do not report them).
SECURITY_ENABLED=true
SECURITY_INTERVAL_SEC=60
# /var/log/auth.log  |  journalctl:ssh  |  file:/path/to/log  (last one is for testing)
AUTH_LOG_SOURCE=/var/log/auth.log
# Alert when one IP produces more than SSH_FAILED_LIMIT failures inside SSH_FAILED_WINDOW_MIN.
SSH_FAILED_LIMIT=10
SSH_FAILED_WINDOW_MIN=10
# Minutes between repeats of the same security alert class.
SECURITY_COOLDOWN_MIN=30
# Diff "ss -tuln" against the saved baseline and alert on new/closed listeners.
PORT_SCAN_ENABLED=true
# Jails to read with "fail2ban-client status <jail>". Leave empty to skip fail2ban.
FAIL2BAN_JAILS=

# ---- log viewer -------------------------------------------------------------
# Master switch for the Logs page. With it off the page has no sources to show.
LOG_ENABLED=true
# The ONLY logs this app will read. Entries are separated by ";" and each one is
#   name=journal:<systemd unit>   -> journalctl -u <unit>   (read via sudo -n)
#   name=pm2:<pm2 app name>       -> pm2 logs <app>
#   name=file:/absolute/path.log  -> tail a plain file
# e.g. LOG_SOURCES=n8n=journal:n8n;node-red=pm2:node-red;nginx=journal:nginx;backup=file:/var/log/rsync-nightly.log
# The dashboard only ever sends the NAME back to the server, which looks it up
# here and builds a fixed argv array for execFile/spawn (no shell, ever), so a
# browser can never name a file or a command that is not already in this list.
# The service account needs the sudoers line from README (log viewer) for journal.
LOG_SOURCES=
# Ceiling for the "lines" control (the UI offers 50 / 200 / 1000, clamped to this).
LOG_MAX_LINES=1000
# How many live SSE tails may run at the same time across all browsers.
# A 3rd stream is refused until one closes. Each stream is one child process
# (journalctl -f / pm2 logs --nostream -f) or one byte-offset poller for files.
LOG_STREAM_MAX=2
# A live tail with no reader for this many minutes is closed by the server.
LOG_IDLE_MIN=10
# File sources are polled at this interval when live tailing (journal/pm2 stream natively).
LOG_POLL_MS=1000
# Every line is masked before it leaves the server (browser, download, AI prompt
# and push body): token/secret/password/key=value pairs, bearer/basic tokens,
# user:pass@ URLs, GitHub/Stripe/AWS/OpenAI style tokens, plus the literal
# values of N8N_API_KEY, AI_API_KEY, TELEGRAM_BOT_TOKEN, PASSWORD and SESSION_SECRET.

# ---- phone app (PWA) --------------------------------------------------------
# No .env switch needed: manifest.webmanifest and sw.js are always served, and the
# browser only installs over HTTPS (or localhost). See README (phone app).
# Optional web push for new incidents. Generate a key pair with:
#   node scripts/gen-vapid.mjs
# Leave both blank to keep push off — Telegram stays the primary channel and the
# Settings page explains what is missing. VAPID_SUBJECT is a contact URI the push
# service shows the operator; mailto: or https: both work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto@admin.local
